#!/usr/bin/env bash
# Secret scan + run plugin tests when plugin source files are staged.
set -euo pipefail

# === Secret scan (staged) ===
if ! command -v gitleaks >/dev/null 2>&1; then
  echo ""
  echo "ERROR: gitleaks is not installed. Install with: brew install gitleaks"
  echo "Commits are blocked until gitleaks is available (prevents committing secrets)."
  exit 1
fi
echo "Scanning staged changes for secrets..."
gitleaks protect --staged --redact --verbose

# === Never-public scan (staged) ===
# gitleaks only knows secrets. This blocks Tailscale addresses and private employer names,
# which are not secrets but must not reach the public GitHub copy.
# Skipped on the sync branch: it has no private list, and sync-to-github.sh runs the full check.
if [ "$(git branch --show-current)" != "__github_sync" ]; then
  echo "Scanning staged changes for text that must stay private..."
  "$(git rev-parse --show-toplevel)/scripts/check-never-public.sh" --staged
fi

STAGED=$(git diff --cached --name-only)

if echo "$STAGED" | grep -q 'plugins/oeid-noteplan-quicknote/\(script\.js\|plugin\.json\)'; then
  echo "▶ oeid-noteplan-quicknote staged — running tests..."
  cd "$(git rev-parse --show-toplevel)"
  make test-noteplan-quicknote-all
fi
