{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(~/.zshrc)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "env": {
    "OTEL_METRICS_EXPORTER": "console"
  },
  "plansDirectory": ".claude/plans",
  "companyAnnouncements": [
    "Welcome!"
  ]
}
