    "check-dead-links":         url_enrichment.cmd_check_dead_links,
    "archive-url":              url_enrichment.cmd_archive_url,
    "enrich-links":             url_enrichment.cmd_enrich_links,
    "fix-links":                link_repair.cmd_fix_links,
    "dashboard-generate":       dashboard.cmd_dashboard_generate,
    "dashboard-open":           dashboard.cmd_dashboard_open,
    "serve":                    server.cmd_serve,
    "conversation-mine":        conversation_mine.cmd_conversation_mine,
    "mine-commit":              conversation_mine.cmd_mine_commit,
    "work-board-generate":      work_board.cmd_work_board_generate,
    "work-board-open":          work_board.cmd_work_board_open,
    "ai-usage-mine":            ai_usage.cmd_ai_usage_mine,
    "ai-usage-generate":        ai_usage.cmd_ai_usage_generate,
    "ai-usage-open":            ai_usage.cmd_ai_usage_open,
    "repo-scan":                ai_usage.cmd_repo_scan,
    "sweep-commit":             sweep_review.cmd_sweep_commit,
    "sweep-review-generate":    sweep_review.cmd_sweep_review_generate,
    "sweep-review-compile":     sweep_review.cmd_sweep_review_compile,
    "sweep-review-squash":      sweep_review.cmd_sweep_review_squash,
    "sweep-review-list":        sweep_review.cmd_sweep_review_list,
    "sweep-review-open":        sweep_review.cmd_sweep_review_open,
}

def cmd_list_commands(_args=None):
    col = max(len(name) for name, _ in COMMANDS) + 2
    for name, desc in COMMANDS:
        print(f"  {name:<{col}}{desc}")

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
def main():
    parser = build_parser()
    args = parser.parse_args()

    # Apply global flags
    utils.DRY_RUN = args.dry_run
    utils.VERBOSE = args.verbose
    utils.QUIET = args.quiet

    if args.command is None:
        parser.print_help()
        sys.exit(utils.EXIT_OK)

    if args.command == "list-commands":
        cmd_list_commands()
        sys.exit(utils.EXIT_OK)

    fn = DISPATCH.get(args.command)
    if fn is None:
        utils.err(f"Unknown command: {args.command}")
        sys.exit(utils.EXIT_NOT_FOUND)

    try:
        fn(args)
    except NotImplementedError as e:
        utils.err(f"'{args.command}' is not yet implemented ({e})")
        sys.exit(utils.EXIT_NOT_FOUND)

if __name__ == "__main__":
    main()
