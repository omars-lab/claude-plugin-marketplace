    "list-workstreams":         discovery.cmd_list_workstreams,
    "list-plans":               discovery.cmd_list_plans,
    "list-templates":           discovery.cmd_list_templates,
    "extract-domains":          discovery.cmd_extract_domains,
    "clone-template":           discovery.cmd_clone_template,
    "clone-plan":               discovery.cmd_clone_plan,
    "fetch-title":              url_enrichment.cmd_fetch_title,
    "to-markdown-link":         url_enrichment.cmd_to_markdown_link,
    "fetch-metadata":           url_enrichment.cmd_fetch_metadata,
    "enrich-urls":              url_enrichment.cmd_enrich_urls,
