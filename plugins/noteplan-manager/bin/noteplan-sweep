    "check-emoji-mappings":     backlinks.cmd_check_emoji_mappings,
    "sync-emoji-mappings":      backlinks.cmd_sync_emoji_mappings,
    "check-living-artifacts":   backlinks.cmd_check_living_artifacts,
    "check-note-map":           backlinks.cmd_check_note_map,
