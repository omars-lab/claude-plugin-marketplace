{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "thread.schema.json",
  "title": "One review thread, as `show --json` prints it",
  "description": "The thread shape page comments share with review-md (design section 12). review-md has no schema file of its own yet; when it takes this one, the two copies are kept identical by a test.",
  "type": "object",
  "required": ["id", "resolved", "status", "anchor", "rev", "messages"],
  "properties": {
    "id": { "type": "string" },
    "resolved": { "type": "boolean", "description": "true when status is not open" },
    "status": { "enum": ["open", "resolved", "dismissed"] },
    "anchor": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["element", "text", "file", "heading"], "description": "element and text are page comments; review-md uses its own kinds" },
        "commentId": { "type": ["string", "null"] },
        "css": { "type": "string" },
        "tag": { "type": "string" },
        "label": { "type": "string", "maxLength": 80 },
        "quote": {
          "type": "object",
          "required": ["exact"],
          "properties": { "exact": { "type": "string" }, "prefix": { "type": "string" }, "suffix": { "type": "string" } }
        },
        "box": {
          "type": "object",
          "properties": { "fx": { "type": "number" }, "fy": { "type": "number" } }
        }
      }
    },
    "rev": {
      "type": "object",
      "properties": {
        "bodyHash": { "type": ["string", "null"] },
        "ts": { "type": "string" },
        "git": {
          "type": "object",
          "properties": { "commit": { "type": ["string", "null"] }, "dirty": { "type": ["boolean", "null"] } }
        }
      }
    },
    "page": {
      "type": "object",
      "properties": { "url": { "type": "string" }, "path": { "type": "string" }, "title": { "type": "string" } }
    },
    "viewport": {
      "type": ["object", "null"],
      "properties": {
        "w": { "type": "number" },
        "h": { "type": "number" },
        "dpr": { "type": "number" },
        "scrollX": { "type": "number" },
        "scrollY": { "type": "number" },
        "scheme": { "enum": ["light", "dark"] }
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["author", "ts", "body"],
        "properties": {
          "author": { "type": "string" },
          "ts": { "type": "string" },
          "body": { "type": "string" },
          "commit": { "type": "string" },
          "edited": { "type": "string" }
        }
      }
    },
    "waiting": { "enum": ["claude", "human", null] },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["status", "author", "ts"],
        "properties": {
          "status": { "enum": ["open", "resolved", "dismissed"] },
          "author": { "type": "string" },
          "ts": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "shots": {
      "type": "array",
      "description": "Pictures of the element (design section 14). Each has exactly one of icloud, local or error; the code that writes them makes sure of that.",
      "items": {
        "type": "object",
        "required": ["role", "ts"],
        "properties": {
          "role": { "enum": ["comment", "after"], "description": "comment: taken when the comment was made; after: Claude's shot after a fix" },
          "ts": { "type": "string" },
          "author": { "type": "string" },
          "icloud": { "type": "string", "description": "path relative to the iCloud Drive root" },
          "local": { "type": "string", "description": "path relative to the repo's .page-comments/ folder" },
          "sha": { "type": "string", "description": "first 12 hex characters of the picture's sha256" },
          "commit": { "type": "string", "description": "after shots: the commit the shot was taken against" },
          "error": { "type": "string", "description": "why the capture failed, in place of a pointer" },
          "path": { "type": "string", "description": "show --json only: the full path of the picture on this Mac, ready to open" }
        }
      }
    },
    "lost": { "type": "boolean" }
  }
}
