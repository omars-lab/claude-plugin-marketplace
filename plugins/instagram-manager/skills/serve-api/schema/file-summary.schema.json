{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "file-summary.schema.json",
  "additionalProperties": false,
  "properties": {
    "file": {
      "description": "travel/<area> or a topic name.",
      "title": "File",
      "type": "string"
    },
    "topic": {
      "title": "Topic",
      "type": "string"
    },
    "area": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Area"
    },
    "feeds": {
      "items": {
        "type": "string"
      },
      "title": "Feeds",
      "type": "array"
    },
    "saves": {
      "title": "Saves",
      "type": "integer"
    },
    "items": {
      "description": "Everything the file's saves name: a travel area's spots, or a topic's dishes, ideas and tips.",
      "title": "Items",
      "type": "integer"
    },
    "spots": {
      "description": "A travel area's spots (the same as items); 0 for any other topic.",
      "title": "Spots",
      "type": "integer"
    }
  },
  "required": [
    "file",
    "topic",
    "feeds",
    "saves",
    "items",
    "spots"
  ],
  "title": "FileSummary",
  "type": "object"
}
