{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "save.schema.json",
  "$defs": {
    "Item": {
      "additionalProperties": false,
      "description": "One thing a save that is not travel names, from split-saves: a dish, a technique, a tip.",
      "properties": {
        "topic": {
          "description": "The topic it is listed under, one of the save's topics.",
          "title": "Topic",
          "type": "string"
        },
        "kind": {
          "description": "What sort of thing it is, set by its topic: dish (recipes); subject or technique (design); idea or product (business, 3D prints); note (any other topic). Not OpenStreetMap's kind.",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "description": "A short name for it.",
          "title": "Name",
          "type": "string"
        },
        "quote": {
          "description": "The caption's own words for it, checked word for word.",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "kind",
        "name",
        "quote"
      ],
      "title": "Item",
      "type": "object"
    },
    "Spot": {
      "additionalProperties": false,
      "description": "One place a save names: a beach, a café, a trailhead.",
      "properties": {
        "name": {
          "description": "The spot's name.",
          "title": "Name",
          "type": "string"
        },
        "said": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The caption's (or the video's) own words for it.",
          "title": "Said"
        },
        "near": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The town, park or area it sits in.",
          "title": "Near"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OpenStreetMap's kind: restaurant, beach, viewpoint…",
          "title": "Kind"
        },
        "lat": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Latitude, from OpenStreetMap, or from Overture Maps when `overture` is set. Only when `exact`.",
          "title": "Lat"
        },
        "lon": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Longitude, from the same source as `lat`. Only when `exact`.",
          "title": "Lon"
        },
        "osm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OpenStreetMap id, such as node/123.",
          "title": "Osm"
        },
        "wikidata": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Wikidata id, when OpenStreetMap has one.",
          "title": "Wikidata"
        },
        "map": {
          "description": "A Google Maps link: the exact place when its place id is kept, else a search for the name in its town.",
          "title": "Map",
          "type": "string"
        },
        "google_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Google's place id, when one is kept. Nothing else of Google's is kept.",
          "title": "Google Id"
        },
        "overture": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overture Maps' place id, when the position is from Overture's open places data. Show its credit with it.",
          "title": "Overture"
        },
        "overture_release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The Overture release the position was read from, such as 2026-09-23.1. Only with `overture`.",
          "title": "Overture Release"
        },
        "licence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The Overture row's licence: CDLA-Permissive-2.0, or Apache-2.0 for rows from Foursquare. Only with `overture`.",
          "title": "Licence"
        },
        "from": {
          "description": "Where the name was read.",
          "enum": [
            "caption",
            "video"
          ],
          "title": "From",
          "type": "string"
        },
        "exact": {
          "description": "True when pinned at the spot itself; false when no open map lists it and it stands at its town (no lat/lon then).",
          "title": "Exact",
          "type": "boolean"
        },
        "listed": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "True when no source places it and no Google id is kept: list it under its town, not on a map. Only when `exact` is false.",
          "title": "Listed"
        },
        "still": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A still from the video, a path in the media folder.",
          "title": "Still"
        },
        "clip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A 3 second clip, a path in the media folder.",
          "title": "Clip"
        },
        "t": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seconds into the video where the still is.",
          "title": "T"
        },
        "still_from": {
          "anyOf": [
            {
              "enum": [
                "name",
                "area"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "name: the spot's name is on screen; area: a shot of its area.",
          "title": "Still From"
        },
        "area": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The area the still shows, when still_from is area.",
          "title": "Area"
        }
      },
      "required": [
        "name",
        "map",
        "from",
        "exact"
      ],
      "title": "Spot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One saved post, as one file lists it.",
  "properties": {
    "code": {
      "description": "Instagram's post code.",
      "title": "Code",
      "type": "string"
    },
    "url": {
      "title": "Url",
      "type": "string"
    },
    "creator": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The account that posted it.",
      "title": "Creator"
    },
    "saved_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When it was saved, from the export.",
      "title": "Saved At"
    },
    "kind": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "post or reel.",
      "title": "Kind"
    },
    "topics": {
      "items": {
        "type": "string"
      },
      "title": "Topics",
      "type": "array"
    },
    "purposes": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "eat, stay, do… for travel saves.",
      "title": "Purposes"
    },
    "places": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The most exact places it is tagged with.",
      "title": "Places"
    },
    "thumb": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Its thumbnail, a path in the media folder.",
      "title": "Thumb"
    },
    "also_in": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The other files it is in: topics, and travel/<area> for other areas.",
      "title": "Also In"
    },
    "items": {
      "description": "Travel: its spots in this file's area. Any other topic: the things its caption names under that topic (empty until split-saves reads it).",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/Spot"
          },
          {
            "$ref": "#/$defs/Item"
          }
        ]
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "code",
    "url",
    "topics",
    "items"
  ],
  "title": "Save",
  "type": "object"
}
